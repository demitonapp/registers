{
  "$id": "demiton:shelf/attendance_record/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "employer": {
      "description": "the company the worker attended for",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "external_id": {
      "description": "the source system's own sign-in id",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "project": {
      "description": "the project whose site was entered",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "sign_in_device": {
      "description": "the device the sign-in was recorded on",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "sign_in_method": {
      "description": "whether the time was captured by a sign-in device or entered by a user",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "signed_in_at": {
      "description": "when the person arrived on site",
      "type": "datetime",
      "x-demiton-requiredness": "required"
    },
    "signed_out_at": {
      "description": "when the person left site",
      "type": "datetime",
      "x-demiton-requiredness": "optional"
    },
    "signed_out_automatically": {
      "description": "whether the sign-out was set by the system rather than the person",
      "type": "boolean",
      "x-demiton-requiredness": "optional"
    },
    "visitor_employer": {
      "description": "the company a visitor came from",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "visitor_name": {
      "description": "the visitor's name, when the person is not a registered worker",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "visitor_reason": {
      "description": "why the visitor attended",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "worker": {
      "description": "the worker who signed in",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
    "project",
    "signed_in_at"
  ],
