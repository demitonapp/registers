    },
    "account_number": {
      "description": "the account number as the tenant's ledger uses it",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "account_sub_category": {
      "description": "the finer classification (BC `subCategory`)",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "account_type": {
      "description": "the BC account-type code",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "external_id": {
      "description": "the source system's own account identifier",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "last_modified_at": {
      "description": "when the source last changed the account",
      "type": "datetime",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "instant"
    },
    "legal_entity_id": {
      "description": "the company that owns the account",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
