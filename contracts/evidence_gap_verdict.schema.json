  "title": "evidence_gap_verdict contract v1",
  "type": "object",
  "x-demiton-contract-version": "1.0.0",
  "x-demiton-domain": "compliance",
  "x-demiton-memory-type": "semantic",
  "x-demiton-provenance": {
    "standards": []
  },
  "x-demiton-shelf-type": "evidence_gap_verdict",
  "x-demiton-store": "tenant"
}
