{
  "$id": "demiton:shelf/expense_claims/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "approval_state": {
      "description": "whether the claim was approved, and by whom",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "claim_amount": {
      "description": "the total amount claimed",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "tenant currency (unit **unverified**)"
    },
    "currency": {
      "description": "the currency both amounts are stated in",
      "type": "money",
      "x-demiton-requiredness": "tenant-specific"
    },
    "description": {
      "description": "the tenant's description of what was purchased",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "evidence_reference": {
      "description": "pointer to the receipt/invoice document the claim is substantiated by",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "expense_category": {
      "description": "the tenant's own classification of the expense",
      "type": "string",
      "x-demiton-requiredness": "tenant-specific"
    },
    "external_id": {
      "description": "the source system's own identifier for the claim submission",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "gst_amount": {
      "description": "the tax component included in `claim_amount`",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "tenant currency (AUD cohort)"
    },
    "incurred_on": {
      "description": "the date the expense was incurred, where the tenant form supplies it distinctly from the submission time",
      "type": "date",
      "x-demiton-requiredness": "optional"
    },
    "submitted_time": {
      "description": "when the claim was submitted; the event time",
      "type": "datetime",
      "x-demiton-requiredness": "required"
    },
    "worker_id": {
      "description": "the worker who submitted the claim; the shelf's subject anchor",
      "type": "integer",
      "x-demiton-requiredness": "required"
    }
  },
  "required": [
    "external_id",
    "worker_id",
    "submitted_time",
    "claim_amount"
  ],
  "title": "expense_claims contract v1",
  "type": "object",
  "x-demiton-contract-version": "1.0.1",
  "x-demiton-provenance": {
    "standards": [
      {
