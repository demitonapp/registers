{
  "$id": "demiton:shelf/profit_and_loss/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actual_amount": {
      "description": "actual cost to date (BC `Total_Cost`)",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "AUD"
    },
    "budget_amount": {
      "description": "the project budget at the snapshot (BC `Total_Budget`)",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "AUD"
    },
    "claimed_to_date_amount": {
      "description": "value invoiced to date (BC `Total_Invoiced`)",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AUD"
    },
    "commitments_amount": {
      "description": "open purchase-commitment value (BC `Total_Commitments`)",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AUD"
    },
    "contract_value_amount": {
      "description": "the contracted value of the job (BC `Total_Contract_Value`)",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AUD"
    },
    "currency": {
      "description": "the currency the amounts are in; today the field names hard-code AUD and the writer passes `currency_code=\"AUD\"`",
      "type": "money",
      "x-demiton-requiredness": "optional"
    },
    "financial_period": {
      "description": "the accounting period the snapshot covers",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "gross_margin_amount": {
      "description": "revenue less actual cost (`Total_Revenue(abs) - Total_Cost`)",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AUD"
    },
    "gross_margin_pct": {
      "description": "`gross_margin_amount / revenue * 100`",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "percent (%)"
    },
    "job_no": {
      "description": "the Business Central job number the fact was read for; the join key between the fact and the project spine",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "project_id": {
      "description": "the project (BC job) the snapshot belongs to; the fact's subject anchor",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "summary": {
      "description": "the one-line human-readable financial position, for citation/search",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "variance_amount": {
      "description": "`budget_amount - (actual_amount + commitments_amount)`; the writer's `variance_aud`",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AUD"
    }
  },
  "required": [
    "project_id",
    "financial_period",
    "budget_amount",
    "actual_amount"
  ],
  "title": "profit_and_loss contract v2",
  "type": "object",
  "x-demiton-contract-version": "2.0.0",
