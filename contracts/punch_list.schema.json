{
  "$id": "demiton:shelf/punch_list/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assignee": {
      "description": "who must fix it",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "category": {
      "description": "the kind of defect",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "closed_at": {
      "description": "when the item was closed",
      "type": "datetime",
      "x-demiton-requiredness": "optional"
    },
    "closed_by": {
      "description": "who closed it",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "cost_code": {
      "description": "the cost code the fix is charged to",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "cost_impact_amount": {
      "description": "the cost the defect adds",
      "type": "money",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AUD"
