    "external_id": {
      "description": "the source system's own item id",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "final_approver": {
      "description": "who signs the fix off",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "location": {
      "description": "where on site the defect is",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "manager": {
      "description": "who manages the item",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "name": {
      "description": "the defect's short title",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "priority": {
      "description": "how urgent the fix is",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "project": {
      "description": "the project the defect is on",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "raised_by": {
      "description": "who recorded the defect",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "schedule_impact_days": {
      "description": "the programme slip the defect causes",
      "type": "integer",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "days"
    },
    "status": {
      "description": "the item's lifecycle state",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "trade": {
      "description": "the trade responsible for the fix",
      "type": "string",
      "x-demiton-requiredness": "optional"
    }
