    "description": {
      "description": "what is wrong",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "due_date": {
      "description": "when the fix is due",
      "type": "date",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "day"
