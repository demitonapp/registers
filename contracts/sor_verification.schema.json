        "region": "Australia",
        "title": "Geotechnical site investigations"
      },
      {
        "access": "paywalled_secondary",
        "checked_on": "2026-09-14",
        "code": "AS 5488.1:2022",
        "edition": "2022 (supersedes 2019)",
        "region": "Australia",
        "title": "Classification of Subsurface Utility Information (SUI)"
      },
      {
        "access": "paywalled_secondary",
        "checked_on": "2026-09-14",
        "code": "AS ISO 19650.1:2019 / AS ISO 19650.2:2019",
        "edition": "2019",
        "region": "Australia",
        "title": "Organization and digitization of information about buildings and civil engineering works - Part 1 concepts and principles (identical to ISO 19650-1:2018)"
      },
      {
        "access": "paywalled_secondary",
        "checked_on": "2026-09-14",
        "code": "AS ISO 19650.2:2019",
        "edition": "2019",
        "region": "Australia",
        "title": "Organization and digitization of information - Part 2 delivery phase of the assets (identical to ISO 19650-2:2018)"
      },
      {
        "access": "public_summary",
        "checked_on": "2026-09-14",
        "code": "ICMS 3",
        "edition": "3rd edition (2021)",
        "region": "International",
        "title": "International Cost Management Standard"
      },
      {
        "access": "paywalled_secondary",
        "checked_on": "2026-09-14",
        "code": "ISO 19650-1:2018 / ISO 19650-2:2018",
        "edition": "2018",
        "region": "International",
        "title": "Organization and digitization of information about buildings and civil engineering works, including BIM - Parts 1 and 2"
      }
    ]
  },
  "x-demiton-shelf-type": "sor_verification",
  "x-demiton-store": "tenant"
}
