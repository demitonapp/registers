{
  "$id": "demiton:shelf/asset_utilisation/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "asset": {
      "description": "the machine the reading belongs to",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "device": {
      "description": "the telematics device that produced the reading",
      "type": "number",
      "x-demiton-requiredness": "optional"
    },
    "distance_period": {
      "description": "distance delta over the reading window, ADDITIVE",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "km"
    },
    "energy_used": {
      "description": "cumulative energy counter; meaning and unit not documented in any digest read",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "kWh (**unverified**)"
    },
    "engine_hours": {
      "description": "lifetime GPS engine-hours meter, CUMULATIVE (never summed)",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "hours"
    },
    "engine_hours_can": {
      "description": "CAN-bus lifetime engine-hours twin, CUMULATIVE",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "hours"
    },
    "engine_hours_period": {
      "description": "engine-hours delta over the reading window, ADDITIVE",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "hours"
    },
    "financial_period": {
      "description": "the period the reading is attributed to",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "fuel": {
      "description": "CAN-bus tank-level reading, INSTANTANEOUS (never summed)",
      "type": "number",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "pct"
    },
    "fuel_period": {
      "description": "fuel consumed over the reading window, ADDITIVE",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "litres"
    },
    "location": {
      "description": "last known position/place as delivered by the source; datum and unit **unverified**",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "occurred_at": {
      "description": "the timestamp of the reading snapshot",
      "type": "datetime",
      "x-demiton-requiredness": "required"
    },
    "odometer": {
      "description": "lifetime GPS odometer, CUMULATIVE",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "km"
    },
    "odometer_can": {
      "description": "CAN-bus lifetime odometer twin, CUMULATIVE",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "km"
    },
    "operator": {
      "description": "the operator/driver attributed at reading time",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "project": {
      "description": "the project the asset was working on",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "range": {
      "description": "cumulative/remaining range counter; meaning and unit not documented",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "km (**unverified**)"
    },
    "source_system": {
      "description": "which bound system emitted the row",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "source_units": {
      "description": "the source unit each measure arrived in, beside the canonical unit",
      "type": "object",
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
    "asset",
    "occurred_at",
    "source_system",
    "engine_hours",
    "odometer"
  ],
  "title": "asset_utilisation contract v1",
  "type": "object",
  "x-demiton-contract-version": 1,
  "x-demiton-provenance": {
    "standards": []
  },
  "x-demiton-shelf-type": "asset_utilisation",
  "x-demiton-store": "tenant"
}
