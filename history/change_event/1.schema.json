{
  "$id": "demiton:shelf/change_event/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "accepted_days": {
      "description": "the programme extension accepted",
      "type": "integer",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "days"
    },
    "budget_impact": {
      "description": "the estimated effect on budget",
      "type": "money",
      "x-demiton-requiredness": "optional"
    },
    "change_items": {
      "description": "the event's itemised cost, budget and revenue lines",
      "type": "array",
      "x-demiton-requiredness": "optional"
    },
    "change_reason": {
      "description": "why the change arose",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "change_type": {
      "description": "the kind of change",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "cost_impact": {
      "description": "the estimated effect on cost",
      "type": "money",
      "x-demiton-requiredness": "optional"
    },
    "currency": {
      "description": "the currency of the impact amounts",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "description": {
      "description": "what happened",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "external_id": {
      "description": "the source system's own change event id",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "number": {
      "description": "the change event number",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "origin": {
      "description": "what raised the event, e.g. an RFI or an instruction",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "prime_contract": {
      "description": "the head contract the event is estimated against",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "project": {
      "description": "the project the change event is on",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "raised_at": {
      "description": "when the event was raised",
      "type": "datetime",
      "x-demiton-requiredness": "optional"
    },
    "raised_by": {
      "description": "who raised the event",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "requested_days": {
      "description": "the programme extension sought",
      "type": "integer",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "days"
    },
    "revenue_impact": {
      "description": "the estimated effect on revenue",
      "type": "money",
      "x-demiton-requiredness": "optional"
    },
    "scope": {
      "description": "whether the change is in or out of the contract scope",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "source_system": {
      "description": "which bound system emitted the row",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "status": {
      "description": "where the event is in its lifecycle",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "title": {
      "description": "what the potential change is",
      "type": "string",
      "x-demiton-requiredness": "required"
    }
  },
  "required": [
    "external_id",
    "source_system",
    "project",
    "title",
    "status"
  ],
  "title": "change_event contract v1",
  "type": "object",
  "x-demiton-contract-version": 1,
  "x-demiton-domain": "contracts",
  "x-demiton-memory-type": "episodic",
  "x-demiton-provenance": {
    "standards": []
  },
  "x-demiton-shelf-type": "change_event",
  "x-demiton-store": "tenant"
}
