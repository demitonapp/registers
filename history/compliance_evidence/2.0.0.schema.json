{
  "$id": "demiton:shelf/compliance_evidence/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "required": [
          "media_kind"
        ]
      },
      "then": {
        "required": [
          "approval_state"
        ]
      }
    }
  ],
  "properties": {
    "approval_state": {
      "description": "Four-eyes state of an uploaded row; required whenever `media_kind` is set. Readers count only `approved`",
      "enum": [
        "submitted",
        "approved",
        "rejected"
      ],
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "approved_at": {
      "description": "When the evidence was approved or rejected",
      "type": "datetime",
      "x-demiton-requiredness": "optional"
    },
    "approved_by": {
      "description": "User id of the person who approved or rejected the evidence; never the submitter on an approval",
      "type": "integer",
      "x-demiton-requiredness": "optional"
    },
    "captured_at": {
      "description": "When the photo or document was captured, as the device reported it",
      "type": "datetime",
      "x-demiton-requiredness": "optional"
    },
    "captured_on_site": {
      "description": "Whether the device placed the capture on the project site",
      "type": "boolean",
      "x-demiton-requiredness": "optional"
    },
    "certificate_number": {
      "description": "Certificate identifier",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "certifying_body": {
      "description": "Issuing body (certification body, insurer)",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "classifications": {
      "description": "Scheme classification levels (today NPS `R`/`B`/`F`/`A`), only when `scheme_key` is a classified scheme",
      "type": "object",
      "x-demiton-requiredness": "optional"
    },
    "evidence_type": {
      "description": "`register` \\",
      "type": "string",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "`policy` \\"
    },
    "expires_at": {
      "description": "Expiry date; readers derive lapsed/current from it",
      "type": "date",
      "x-demiton-requiredness": "optional"
    },
    "issued_at": {
      "description": "Issue date",
      "type": "date",
      "x-demiton-requiredness": "optional"
    },
    "media_kind": {
      "description": "What a person uploaded as the evidence; absent on a row from a connected system",
      "enum": [
        "photo",
        "document"
      ],
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "media_sha256": {
      "description": "SHA-256 of the uploaded file",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "note": {
      "description": "Free-text note on the evidence",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "obligation_key": {
      "description": "Recurring obligation the evidence completes",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "rejection_reason": {
      "description": "Why the evidence was rejected",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "requirement_id": {
      "description": "Requirement clause the evidence covers",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "scheme_key": {
      "description": "Scheme/panel the evidence supports (catalog key)",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "scope": {
      "description": "Certified/insured scope statement",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "source_external_id": {
      "description": "The raw evidence record's id in the producing system",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "source_path": {
      "description": "Document path in the org's IMS store \u2014 the upsert key across re-crawls",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "standard_edition": {
      "description": "Edition of the certified standard (e.g. `ISO 14001:2015`, `ISO 14001:2026`)",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "subject_entity_id": {
      "description": "The org spine node the evidence supports (the fact subject)",
      "type": "integer",
      "x-demiton-requiredness": "required"
    },
    "submitted_at": {
      "description": "When the evidence was uploaded",
      "type": "datetime",
      "x-demiton-requiredness": "optional"
    },
    "submitted_by": {
      "description": "User id of the signed-in person who uploaded the evidence",
      "type": "integer",
      "x-demiton-requiredness": "optional"
    },
    "summary": {
      "description": "Rendered prose summary of the evidence",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "title": {
      "description": "Display title of the artefact",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "verified_at": {
      "description": "When Demiton verified the evidence row",
      "type": "datetime",
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
    "subject_entity_id",
    "source_external_id"
  ],
  "title": "compliance_evidence contract v2",
  "type": "object",
  "x-demiton-contract-version": "2.0.0",
