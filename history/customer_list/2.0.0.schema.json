      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "address_line_2": {
      "description": "Street address line 2",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "blocked": {
      "description": "Source's blocked/credit-hold status for the customer",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "city": {
      "description": "Locality",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "country_code": {
      "description": "Customer's country",
