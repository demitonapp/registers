{
  "$id": "demiton:shelf/equipment_assignment/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "asset": {
      "description": "the plant/equipment item assigned",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "external_id": {
      "description": "the source row's own identifier (`id`)",
      "type": "number",
      "x-demiton-requiredness": "required"
    },
    "financial_period": {
      "description": "the period the assignment is attributed to",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "hours": {
      "description": "hours the plant is assigned for",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "hours"
    },
    "occurred_at": {
      "description": "the resource date the assignment is for",
      "type": "date",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "day"
    },
    "project": {
      "description": "the job the plant is assigned to",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "source_system": {
      "description": "which bound system emitted the row",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "status": {
      "description": "the assignment's state",
