        "region": "International",
        "title": "Asset management - Asset management system - Requirements"
      },
      {
        "access": "paywalled_secondary",
        "checked_on": "2026-09-14",
        "clause": "Annex I",
        "code": "ISO/TS 55010",
        "edition": "2024 (2019 edition withdrawn 2025-04-09)",
        "region": "International",
        "title": "Asset management - Guidance on the alignment of financial and non-financial functions"
      }
    ]
  },
  "x-demiton-shelf-type": "equipment_transfer",
  "x-demiton-store": "tenant"
}
