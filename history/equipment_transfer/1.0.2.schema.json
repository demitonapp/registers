{
  "$id": "demiton:shelf/equipment_transfer/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "asset": {
      "description": "the machine or tool that moved",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "external_id": {
      "description": "the transfer line's dedup key",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "financial_period": {
      "description": "the accounting period the movement is attributed to",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "from_location": {
      "description": "the location the asset left",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "from_storage_asset": {
      "description": "the storage unit / container the asset left",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "from_worker": {
      "description": "the worker who held the asset before",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "occurred_at": {
      "description": "when the transfer happened",
      "type": "datetime",
      "x-demiton-requiredness": "required"
    },
    "project": {
      "description": "the project the transfer is attributed to",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "to_location": {
      "description": "the location the asset arrived at",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "to_storage_asset": {
      "description": "the storage unit / container the asset arrived in",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "to_worker": {
      "description": "the worker who received custody",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
    "asset",
    "occurred_at",
    "external_id",
    "from_location",
    "to_location"
  ],
  "title": "equipment_transfer contract v1",
  "type": "object",
  "x-demiton-contract-version": "1.0.2",
  "x-demiton-provenance": {
