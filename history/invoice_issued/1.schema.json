{
  "$id": "demiton:shelf/invoice_issued/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "amount_excluding_tax": {
      "description": "Net amount before tax.",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "currency"
    },
    "amount_including_tax": {
      "description": "Gross amount billed, tax included; the shelf's additive measure.",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "currency"
    },
    "amount_outstanding": {
      "description": "Unpaid balance at last sync.",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "currency"
    },
    "buyer_reference": {
      "description": "The customer's own purchase-order reference.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "currency_code": {
      "description": "Denomination of the amounts.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "customer_address": {
      "description": "Bill-to address block, collapsed to one field.",
      "type": "object",
      "x-demiton-requiredness": "optional"
    },
    "customer_name": {
      "description": "Human-readable customer name as billed.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "customer_ref": {
      "description": "Anchor to the customer entity this revenue belongs to.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "customer_tax_id": {
      "description": "Customer ABN/VAT/GST registration identifier.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "document_concept": {
      "description": "Which national document concept this record is (tax invoice, NZ taxable supply information, EU VAT invoice, recipient-created form).",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "due_date": {
      "description": "Date payment falls due.",
      "type": "date",
      "x-demiton-requiredness": "optional"
    },
    "financial_period": {
      "description": "Accounting period the event lands in.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "invoice_number": {
      "description": "The issuer's sequential identifier for this invoice.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "issue_date": {
      "description": "Date the invoice was issued.",
      "type": "date",
      "x-demiton-requiredness": "required"
    },
    "issuing_status": {
      "description": "The issuer's lifecycle status for the document (draft/posted/paid/cancelled).",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "last_modified_at": {
      "description": "Source-system modification stamp, for delta harvest and staleness.",
      "type": "datetime",
      "x-demiton-requiredness": "optional"
    },
    "order_reference": {
      "description": "The sales order this invoice fulfils.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "payment_terms_ref": {
      "description": "Reference to the payment-terms master record.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "project_ref": {
      "description": "Project/contract the revenue is attributable to.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "specification_identifier": {
      "description": "The e-invoicing specification/profile the document was issued under (e.g. a PINT A-NZ or Peppol BIS identifier).",
      "type": "string",
      "x-demiton-requiredness": "tenant-specific"
    },
    "supplier_legal_entity_ref": {
      "description": "The issuing legal entity, so the supplier's ABN/identity is reachable.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "system_reference": {
      "description": "Source system plus native id (`id`) for traceability back to the originating record.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "tax_amount": {
      "description": "Tax charged on this invoice.",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "currency"
    },
    "tax_jurisdiction": {
      "description": "Country whose tax rules produced `tax_amount`.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "tax_rate": {
      "description": "Rate applied to produce `tax_amount` (AU 10%, NZ 15%, UK 20%).",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "percent"
    }
  },
  "required": [
    "invoice_number",
    "issue_date",
    "customer_ref",
    "financial_period",
    "amount_including_tax",
    "document_concept",
    "amount_excluding_tax",
    "tax_amount",
    "tax_jurisdiction",
    "currency_code"
  ],
  "title": "invoice_issued contract v1",
  "type": "object",
  "x-demiton-contract-version": 1,
  "x-demiton-provenance": {
    "standards": []
  },
  "x-demiton-shelf-type": "invoice_issued",
  "x-demiton-store": "tenant"
}
