{
  "$id": "demiton:shelf/market_intelligence/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "austender_count": {
      "description": "federal contribution",
      "type": "integer",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "count"
    },
    "ckan_count": {
      "description": "state-portal contribution",
      "type": "integer",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "count"
    },
    "confidence": {
      "description": "producer confidence; fixed at 1.0 today (`:615`, `:651`)",
      "type": "decimal",
      "x-demiton-requiredness": "optional"
    },
    "content": {
      "description": "the human-readable summary sentence (`:595\u2013601`)",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "contract_count": {
      "description": "how many awarded contracts the scan matched",
      "type": "integer",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "count"
    },
    "generated_at": {
      "description": "when the snapshot was produced; today `run_date` in `structured` (`:624`) and `valid_from` (`:612`)",
      "type": "datetime",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "ISO-8601"
    },
    "memory_type": {
      "description": "this is a durable conclusion, not an event",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "organization_id": {
      "description": "the tenant whose ABN and work types were scanned; the shelf is `store=tenant`, `data_scope=operations`",
      "type": "integer",
      "x-demiton-requiredness": "required"
    },
    "shelf_type": {
      "description": "the shelf identity this atom belongs to; today the write lands on the suffixed per-atom value while the declared pattern key is `market_intelligence` (`:671`)",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "snapshot_id": {
      "description": "stable per-run identity, today `market_snapshot:{org_id}:{YYYY-MM-DD}` (`:609`) and repeated as `citation.external_ref` (`:638`)",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "socrata_count": {
      "description": "ACT/Socrata contribution; present in the Redis payload (`:251`) but **not** in the fact today",
      "type": "integer",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "count"
    },
    "source_system": {
      "description": "canonical origin of the synthesis; today `\"DEMITON\"`",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "sources": {
      "description": "which retrievals contributed (AusTender / CKAN / ACT)",
      "type": "array",
      "x-demiton-requiredness": "required"
    },
    "subject_entity_id": {
      "description": "the org entity the atom is anchored to; the anchor the shared helper resolves",
      "type": "integer",
      "x-demiton-requiredness": "required"
    },
    "total_value_aud": {
      "description": "sum of `value_aud` across matched contracts (`:591`)",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "AUD"
    },
    "valid_from": {
      "description": "currency of the conclusion",
      "type": "datetime",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "ISO-8601"
    },
    "workflow_run_id": {
      "description": "the run that produced the snapshot (`:614`)",
      "type": "integer",
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
    "shelf_type",
    "memory_type",
    "organization_id",
    "subject_entity_id",
    "snapshot_id",
    "source_system",
    "generated_at",
    "contract_count",
    "total_value_aud",
    "sources"
  ],
  "title": "market_intelligence contract v1",
  "type": "object",
  "x-demiton-contract-version": 1,
  "x-demiton-provenance": {
    "standards": []
  },
  "x-demiton-shelf-type": "market_intelligence",
  "x-demiton-store": "tenant"
}
