{
  "$id": "demiton:shelf/payable_entry/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "amount": {
      "description": "the signed movement of the line",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "AUD (BY_COORDINATE)"
    },
    "currency": {
      "description": "the transaction currency of the amounts",
      "type": "currency",
      "x-demiton-requiredness": "optional"
    },
    "document_date": {
      "description": "the date of the supplier document, distinct from posting",
      "type": "date",
      "x-demiton-requiredness": "optional"
    },
    "document_number": {
      "description": "the source supplier document (bill / credit memo) number",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "document_type": {
      "description": "the BC ledger document type (invoice / credit memo / payment / application)",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "due_date": {
      "description": "the date the payable falls due",
      "type": "date",
      "x-demiton-requiredness": "required"
    },
    "external_id": {
      "description": "the source entry's own identifier (BC `Entry_No`)",
      "type": "number",
      "x-demiton-requiredness": "required"
    },
    "financial_period": {
      "description": "the accounting period the entry falls in",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "gl_account": {
      "description": "the ledger account the line posts to",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "is_open": {
      "description": "whether the entry is still open",
      "type": "boolean",
      "x-demiton-requiredness": "optional"
    },
    "legal_entity": {
      "description": "the company whose books the entry belongs to",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "occurred_at": {
      "description": "the posting date the entry was booked on",
      "type": "datetime",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "instant"
    },
    "pmt_discount_date": {
      "description": "the settlement-discount date, if the supplier offers one",
      "type": "date",
      "x-demiton-requiredness": "optional"
    },
    "project": {
      "description": "the job the payable is attributed to, when the source supplies one",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "purchaser_code": {
      "description": "the BC buyer/purchaser code on the entry",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "remaining": {
      "description": "the running balance still outstanding on the entry",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "AUD (BY_COORDINATE)"
    },
    "source_system": {
      "description": "the system the entry was read from",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "vendor": {
      "description": "the supplier the payable is owed to",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    }
  },
  "required": [
    "source_system",
    "external_id",
    "occurred_at",
    "vendor",
    "financial_period",
    "amount",
    "remaining",
    "due_date"
  ],
  "title": "payable_entry contract v2",
  "type": "object",
  "x-demiton-contract-version": "2.0.0",
