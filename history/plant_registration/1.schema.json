{
  "$id": "demiton:shelf/plant_registration/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "asset": {
      "description": "the plant the registration is held against",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "design_standard": {
      "description": "the design standard the plant was registered against",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "external_id": {
      "description": "the source system's id for the registration record",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "hazard_level": {
      "description": "the pressure equipment hazard level, A to D",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "jurisdiction": {
      "description": "the state or territory the registration is under",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "next_major_inspection_due": {
      "description": "when the registration's major inspection falls due",
      "type": "date",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "day"
    },
    "plant_category": {
      "description": "the Schedule 5 category the plant falls in",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "rated_capacity": {
      "description": "the plant's rated capacity or safe working load",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "tonnes"
    },
    "registered_on": {
      "description": "when the registration was granted",
      "type": "date",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "day"
    },
    "registration_kind": {
      "description": "whether this registers a plant design or a plant item",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "registration_number": {
      "description": "the regulator's registration number",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "regulator": {
      "description": "the regulator that issued the registration",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "source_system": {
      "description": "which bound system emitted the row",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "status": {
      "description": "whether the registration is current, lapsed or cancelled",
      "type": "string",
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
    "source_system",
    "asset",
    "registration_kind",
    "registration_number",
    "regulator",
    "jurisdiction"
  ],
  "title": "plant_registration contract v1",
  "type": "object",
  "x-demiton-contract-version": 1,
  "x-demiton-domain": "assets",
  "x-demiton-memory-type": "semantic",
  "x-demiton-provenance": {
    "standards": []
  },
  "x-demiton-shelf-type": "plant_registration",
  "x-demiton-store": "tenant"
}
