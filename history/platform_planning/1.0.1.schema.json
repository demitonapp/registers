      "x-demiton-unit": "ISO 3166-1 alpha-2 or AU state code"
    },
    "network_name": {
      "description": "AER regulatory-period envelope attributes.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "occurred_at": {
      "description": "Valid-time the notice became true; drives freshness and ordering.",
      "type": "datetime",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "ISO 8601"
    },
    "ocid": {
      "description": "The source record's own natural key; provenance and the release identity across harvests.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "procurement_method": {
      "description": "Published procurement method, where the source gives one.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "procurement_phase": {
      "description": "Source's own phase label (e.g. planning vs construction).",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "project_id": {
      "description": "Resolved civil-project roll-up; the primary lifecycle tracking axis.",
      "type": "integer",
      "x-demiton-requiredness": "required"
    },
    "region_code": {
      "description": "Geographic scope of the work.",
      "type": "string",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AU/NZ state code or `AU`"
    },
    "shelf_type": {
      "description": "`platform_planning` \u2014 the stage discriminator.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "source_dataset": {
      "description": "Producer identity (the harvested system, lowercased).",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "source_id": {
      "description": "Source-native record id; idempotency key with `source_dataset`.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "stage": {
      "description": "Source-stage label; always the planning stage for this shelf.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "subtype": {
      "description": "Distinguishes AER's 5-year regulatory capex envelopes from project-level notices.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "title": {
      "description": "Human-readable name of the planned work.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "url": {
      "description": "Canonical source link for citation.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "value_aud": {
      "description": "Estimated or budgeted value of the planned work; the single declared measure.",
      "type": "number",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AUD"
    },
    "value_max_aud": {
      "description": "Upper bound of a published value range.",
      "type": "number",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AUD"
    },
    "value_min_aud": {
      "description": "Lower bound of a published value range.",
      "type": "number",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AUD"
    }
  },
  "required": [
    "ocid",
    "source_dataset",
    "source_id",
    "title",
    "agency_name",
    "agency_id",
    "project_id",
    "shelf_type",
    "stage",
    "occurred_at"
