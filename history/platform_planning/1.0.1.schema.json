      "x-demiton-requiredness": "optional"
    },
    "construction_start": {
      "description": "ANZIP's construction window.",
      "type": "date",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "ISO 8601"
    },
    "delivery_model": {
      "description": "Published delivery/contract model.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "description": {
      "description": "Longer published description of the planned work.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "determination_date": {
      "description": "Date of AER's final determination.",
      "type": "date",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "ISO 8601"
    },
    "expected_start_date": {
      "description": "Expected commencement of the work.",
      "type": "date",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "ISO 8601"
