{
  "$id": "demiton:shelf/progress_claim/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "amount": {
      "description": "value claimed against the project",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "`by_coordinate`"
    },
    "certified_amount": {
      "description": "amount assessed/certified (vs claimed)",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "`by_coordinate`"
    },
    "currency": {
      "description": "denomination of `amount`",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "document_no": {
      "description": "source document reference for the line",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "due_date": {
      "description": "statutory/contractual date payment falls due",
      "type": "date",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "ISO 8601"
    },
    "external_id": {
      "description": "source record identity / dedup key",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "financial_period": {
      "description": "accounting period the claim posts in",
      "type": "date",
      "x-demiton-requiredness": "required"
    },
    "job_task_no": {
      "description": "work package / cost code the line belongs to",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "legal_entity": {
      "description": "company that owns the claiming entity",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "occurred_at": {
      "description": "posting date of the ledger line",
      "type": "datetime",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "ISO 8601"
    },
    "project": {
      "description": "the project/job the claim is posted against",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "quantity": {
      "description": "quantity claimed",
      "type": "number",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "dimensionless"
    },
    "tax_basis": {
      "description": "whether `amount` includes tax",
      "type": "string",
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
    "project",
    "financial_period",
    "occurred_at",
    "external_id",
    "amount",
    "quantity"
  ],
  "title": "progress_claim contract v1",
  "type": "object",
  "x-demiton-contract-version": 1,
  "x-demiton-provenance": {
    "standards": []
  },
  "x-demiton-shelf-type": "progress_claim",
  "x-demiton-store": "tenant"
}
