{
  "$id": "demiton:shelf/project_details/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "address": {
      "description": "Street/site address of the works",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "client_name": {
      "description": "The customer/principal name for the project",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "country_code": {
      "description": "Project country, default AU",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "end_date": {
      "description": "Contract/works completion date",
      "type": "date",
      "x-demiton-requiredness": "optional"
    },
    "job_number": {
      "description": "The canonical project code, `entity.canonical_key` \u2014 BC job number with optional Assignar sub-project suffix",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "lifecycle_stage": {
      "description": "The project's own lifecycle stage (estimating / delivering / complete), when the source provides one",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "name": {
      "description": "Human-readable project name, `entity.label`",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "postcode": {
      "description": "Australian postal code of the works",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "start_date": {
      "description": "Contract/works start date",
      "type": "date",
      "x-demiton-requiredness": "optional"
    },
    "state": {
      "description": "Australian state/territory of the works",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "suburb": {
      "description": "Locality of the works",
      "type": "string",
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
    "job_number",
    "name"
  ],
  "title": "project_details contract v1",
  "type": "object",
  "x-demiton-contract-version": 1,
  "x-demiton-provenance": {
    "standards": []
  },
  "x-demiton-shelf-type": "project_details",
  "x-demiton-store": "tenant"
}
