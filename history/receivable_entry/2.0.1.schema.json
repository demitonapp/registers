{
  "$id": "demiton:shelf/receivable_entry/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "amount": {
      "description": "the signed movement of the line",
      "type": "decimal",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "by_coordinate"
    },
    "currency": {
      "description": "the transaction currency of the amounts",
