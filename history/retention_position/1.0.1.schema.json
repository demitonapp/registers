      "description": "Which system actually supplied `retention_amount` (today the constant `bc_job_card_unpopulated`)",
      "type": "string",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "n/a"
    },
    "retention_basis": {
      "description": "How the retention was calculated (percent of each claim, accumulated, cap)",
      "type": "string",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "n/a"
    },
    "retention_currency": {
      "description": "The currency the amount is denominated in",
      "type": "string",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "n/a"
    },
    "retention_held": {
      "description": "Whether money is currently withheld by the client",
      "type": "boolean",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "n/a"
    },
    "retention_status": {
      "description": "The producer's lifecycle code: `PC`, `DLP`, `BG`, `COMPLETED`",
      "type": "string",
      "x-demiton-requiredness": "tenant-specific",
      "x-demiton-unit": "n/a"
    }
  },
  "required": [
    "project_ref",
    "retention_held"
  ],
