      "type": "string",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "n/a"
    },
    "project_ref": {
      "description": "The subject project's stable external reference (today the ERP job number).",
      "type": "string",
      "x-demiton-requiredness": "required",
      "x-demiton-unit": "n/a"
    },
    "retention_amount": {
      "description": "The amount currently withheld, as recorded by the source",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "currency of the bound legal entity"
    },
