      "x-demiton-requiredness": "optional"
    },
    "occurred_at": {
      "description": "When the non-conformance was submitted/occurred; the reporting clock.",
      "type": "datetime",
      "x-demiton-requiredness": "required"
    },
    "project": {
      "description": "Project the NCR attaches to.",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "source_system": {
      "description": "Originating system; today always `ASSIGNAR`.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "worker": {
      "description": "Worker who raised or is responsible for the NCR; resolves to the worker spine.",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
    "external_id",
    "source_system",
    "occurred_at",
    "financial_period",
