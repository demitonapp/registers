      "x-demiton-requiredness": "required",
      "x-demiton-unit": "`YYYY-MM`"
    },
    "form_id": {
      "description": "The source form template the NCR was captured on.",
      "type": "number",
      "x-demiton-requiredness": "required"
    },
    "form_title": {
      "description": "The source form template's title \u2014 which tenant NCR template this is, and whether it is the quality or safety variant.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "jurisdiction": {
      "description": "The WHS/quality regime whose notification and retention rules apply to this record.",
      "type": "jurisdiction",
      "x-demiton-requiredness": "optional"
    },
    "modified_time": {
      "description": "Source last-modified time; the delta-harvest cursor.",
      "type": "datetime",
      "x-demiton-requiredness": "optional"
    },
    "narrative": {
      "description": "The non-conformance description and what was done, composed from the source responses Q&A; may be null when nothing is renderable.",
