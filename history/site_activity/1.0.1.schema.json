    "activity": {
      "description": "what work was performed",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "asset": {
      "description": "the plant/equipment used",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    },
    "financial_period": {
