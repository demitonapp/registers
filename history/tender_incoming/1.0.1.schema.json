{
  "$id": "demiton:shelf/tender_incoming/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "addenda": {
      "description": "amendments issued against the brief",
      "type": "array",
      "x-demiton-requiredness": "optional"
    },
    "client": {
      "description": "the issuing authority/principal",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "closing_date": {
      "description": "the lodgement deadline",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "contract_type": {
      "description": "the commercial vehicle the brief contemplates",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "currency": {
      "description": "the currency `estimated_value` is denominated in",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "documents_found": {
      "description": "catalogue of files in the source folder",
      "type": "array",
      "x-demiton-requiredness": "optional"
    },
    "estimated_value": {
      "description": "estimated contract value where stated",
      "type": "decimal",
      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "AUD (**unverified** \u2014 no currency field exists in the payload)"
    },
    "estimated_value_note": {
      "description": "the value as written (\"approx $1.2M\")",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "has_boq": {
      "description": "a bill of quantities was found",
      "type": "boolean",
      "x-demiton-requiredness": "optional"
    },
    "has_invitation": {
      "description": "an invitation to tender was found",
      "type": "boolean",
      "x-demiton-requiredness": "optional"
    },
    "has_scope_doc": {
      "description": "a scope document was found",
      "type": "boolean",
      "x-demiton-requiredness": "optional"
    },
    "location": {
      "description": "physical location of the works from the document",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "principal_type": {
      "description": "the class of issuing party",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "scope_summary": {
      "description": "LLM summary of the works being tendered",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "source_document_file_name": {
      "description": "the file the fact was extracted from",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "source_document_path": {
      "description": "the SharePoint item path/locator",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "state": {
      "description": "AU state from the folder name",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "tender_source": {
      "description": "where the brief came from (\"TfNSW BuyNSW\", \"email RFQ\", \"VendorPanel\")",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "title": {
      "description": "the tender brief's own title",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "value_basis": {
      "description": "what kind of value was extracted",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "value_tax_basis": {
      "description": "whether `estimated_value` includes tax",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "work_types": {
      "description": "normalised work categories",
      "type": "array",
      "x-demiton-requiredness": "required"
    }
  },
  "required": [
    "title",
    "client",
    "closing_date",
    "scope_summary",
    "work_types",
    "source_document_file_name",
    "source_document_path"
  ],
  "title": "tender_incoming contract v1",
  "type": "object",
  "x-demiton-contract-version": "1.0.1",
