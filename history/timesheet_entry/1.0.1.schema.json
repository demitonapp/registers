      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "task_name": {
      "description": "the task/activity the hours were worked on",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "work_type": {
      "description": "the vendor/tenant pay-category or work-type label",
      "type": "string",
      "x-demiton-requiredness": "tenant-specific"
    },
    "worker": {
      "description": "the person whose hours these are",
      "type": "string",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    }
  },
  "required": [
    "worker",
    "occurred_at",
    "financial_period",
    "hours",
    "source_system"
