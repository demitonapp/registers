      "x-demiton-requiredness": "optional",
      "x-demiton-unit": "`YYYY-MM`"
    },
    "follow_up_topics": {
      "description": "Topics raised for future discussion.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "issues_raised": {
      "description": "Issues or hazards raised at the meeting.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "narrative": {
      "description": "The Q&A prose composed once at ingress and stored as `Fact.content`.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "occurred_at": {
      "description": "Submission date/time; the event time and the retention clock.",
      "type": "datetime",
      "x-demiton-requiredness": "required"
    },
    "occurred_on": {
      "description": "Date-only form date captured by the reader's date-field detection (source key `diary_date`).",
      "type": "date",
      "x-demiton-requiredness": "optional"
    },
    "project": {
      "description": "Project the talk was held on.",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "required"
    },
    "signature_ref": {
      "description": "Reference to a signature captured on the form.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "source_refs": {
      "description": "Originating system identifiers (`form_id`, `diary_id`, raw `project_id`/`worker_id`) kept for reconciliation instead of freezing vendor column names into the contract.",
      "type": "object",
      "x-demiton-requiredness": "optional"
    },
    "tenant_answers": {
      "description": "The remaining tenant form-template columns, held verbatim. Tenant content, never part of the standard contract, never named outside the tenant.",
      "type": "object",
      "x-demiton-requiredness": "tenant-specific"
    },
    "title": {
      "description": "Title of the form/record that produced the fact (observed source key `form_title`), stamped by the pattern sweep.",
      "type": "string",
      "x-demiton-requiredness": "required"
    },
    "topic": {
      "description": "Subject(s) discussed at the talk.",
      "type": "string",
      "x-demiton-requiredness": "optional"
    },
    "worker": {
      "description": "Worker the talk attaches to at form level (the WORKER anchor).",
      "type": "number",
      "x-demiton-reference": true,
      "x-demiton-requiredness": "optional"
    }
  },
  "required": [
    "external_id",
    "occurred_at",
    "project",
    "title"
  ],
